{
  "uid": "courier",
  "title": "Courier",
  "schemaVersion": 39,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Connections by node",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (node) (courier_connections)",
          "datasource": {
            "type": "prometheus",
            "uid": "prom"
          }
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Messages / s by outcome",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (result) (rate(courier_messages_total[1m]))",
          "datasource": {
            "type": "prometheus",
            "uid": "prom"
          }
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Send latency (persist + ack) p50 / p99",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le) (rate(courier_send_duration_seconds_bucket[1m])))",
          "datasource": {
            "type": "prometheus",
            "uid": "prom"
          }
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(courier_send_duration_seconds_bucket[1m])))",
          "datasource": {
            "type": "prometheus",
            "uid": "prom"
          }
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Fan-out lag p99 by node",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.99, sum by (le, node) (rate(courier_fanout_lag_seconds_bucket[1m])))",
          "datasource": {
            "type": "prometheus",
            "uid": "prom"
          }
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Frames out / s by type",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (type) (rate(courier_frames_out_total[1m]))",
          "datasource": {
            "type": "prometheus",
            "uid": "prom"
          }
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Gap repairs (sync) / s",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (node) (rate(courier_sync_requests_total[1m]))",
          "datasource": {
            "type": "prometheus",
            "uid": "prom"
          }
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Disconnects / s by reason",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (reason) (rate(courier_disconnects_total[1m]))",
          "datasource": {
            "type": "prometheus",
            "uid": "prom"
          }
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Outbox re-publishes & bus reconnects",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 24
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(courier_outbox_swept_total[5m]))",
          "datasource": {
            "type": "prometheus",
            "uid": "prom"
          }
        },
        {
          "refId": "B",
          "expr": "sum(increase(courier_bus_reconnects_total[5m]))",
          "datasource": {
            "type": "prometheus",
            "uid": "prom"
          }
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Rate limiting / s",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 32
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (kind) (rate(courier_rate_limited_total[1m]))",
          "datasource": {
            "type": "prometheus",
            "uid": "prom"
          }
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Event loop lag p99",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 32
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (node) (nodejs_eventloop_lag_p99_seconds)",
          "datasource": {
            "type": "prometheus",
            "uid": "prom"
          }
        }
      ]
    }
  ]
}